# Реальная ЭЭГ из PhysioNet (датасет EEG Motor Movement/Imagery, "eegbci")
# + базовая фильтрация 1-40 Гц.
#
# Что делает скрипт:
#   1. Скачивает одну короткую запись (~1 минута, пара мегабайт) через MNE.
#      Файлы сохраняются в ~/mne_data и при повторном запуске не качаются заново.
#   2. Загружает первый канал (или канал по имени, см. CHANNEL_NAME).
#   3. Фильтрует: полосовой фильтр 1-40 Гц + режекторный (notch) на частоте сети.
#   4. Строит три графика: сырой сигнал, отфильтрованный сигнал и спектр
#      до/после фильтра, чтобы было видно, что именно убрал фильтр.
#
# Установка зависимостей (один раз):  pip install mne matplotlib scipy
# Запуск:                             python real_eeg_physionet.py

import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import welch

import mne
from mne.datasets import eegbci

# ------------------------------------------------------------------
# Настройки
# ------------------------------------------------------------------
SUBJECT = 1             # номер испытуемого (1-109)
RUN = 1                 # номер записи: 1 = покой с открытыми глазами (там видны моргания),
                        #               2 = покой с закрытыми глазами (виден альфа-ритм ~10 Гц)
CHANNEL_NAME = None     # None = первый канал. Для морганий поставьте "Fp1" или "Fp2"
                        # (лобные каналы над глазами - там моргания самые сильные)

L_FREQ = 1.0            # нижняя граница полосы (Гц): убирает постоянную составляющую и дрейф
H_FREQ = 40.0           # верхняя граница полосы (Гц): убирает мышечный шум и сетевую наводку
NOTCH_FREQ = 60.0       # частота сети. Датасет записан в США, поэтому 60 Гц.
                        # Для своей гарнитуры в Кыргызстане/Европе/России ставьте 50.0

PLOT_SECONDS = 10       # сколько секунд показывать на графиках сигнала
PLOT_START = 0          # с какой секунды начинать


def main():
    # 1. Скачивание данных.
    # load_data возвращает список путей к EDF-файлам.
    # Аргументы передаём позиционно: так работает и в старых, и в новых версиях MNE
    # (в MNE 1.6 параметр subject переименовали в subjects).
    print(f"Загрузка: испытуемый {SUBJECT}, запись {RUN}...")
    files = eegbci.load_data(SUBJECT, [RUN], update_path=True)

    # 2. Чтение EDF-файла
    raw = mne.io.read_raw_edf(files[0], preload=True, verbose="error")
    # Приводим имена каналов к стандарту: 'Fc5.' -> 'FC5', 'Fp1.' -> 'Fp1' и т.д.
    eegbci.standardize(raw)

    sfreq = raw.info["sfreq"]
    print(f"Каналов: {len(raw.ch_names)}, частота дискретизации: {sfreq:.0f} Гц, "
          f"длительность: {raw.times[-1]:.1f} с")

    # Выбираем канал
    channel = CHANNEL_NAME or raw.ch_names[0]
    if channel not in raw.ch_names:
        raise ValueError(f"Канала {channel!r} нет. Доступные: {', '.join(raw.ch_names)}")
    raw.pick([channel])
    print(f"Выбран канал: {channel}")

    # 3. Фильтрация (на копии, чтобы сравнить с исходным сигналом)
    filtered = raw.copy()
    # Полосовой фильтр 1-40 Гц (FIR, без фазового сдвига - пики не "уезжают" по времени)
    filtered.filter(l_freq=L_FREQ, h_freq=H_FREQ, verbose="error")
    # Режекторный фильтр на частоте сети. После полосового фильтра 60 Гц уже сильно
    # ослаблены, но notch добивает узкую наводку, если она очень мощная.
    # Применяем, только если частота сети меньше частоты Найквиста (sfreq / 2).
    if NOTCH_FREQ < sfreq / 2:
        filtered.notch_filter(freqs=NOTCH_FREQ, verbose="error")

    # MNE хранит данные в вольтах; переводим в микровольты (как в BrainFlow)
    raw_uv = raw.get_data()[0] * 1e6
    filt_uv = filtered.get_data()[0] * 1e6
    times = raw.times

    # 4. Графики
    # Фрагмент для отображения
    start = int(PLOT_START * sfreq)
    stop = min(int((PLOT_START + PLOT_SECONDS) * sfreq), len(times))
    t = times[start:stop]

    fig, axes = plt.subplots(3, 1, figsize=(12, 9), constrained_layout=True)
    fig.suptitle(f"PhysioNet EEGBCI: испытуемый {SUBJECT}, запись {RUN}, канал {channel}")

    # 4.1 Сырой сигнал: видно смещение (постоянную составляющую) и медленный дрейф
    axes[0].plot(t, raw_uv[start:stop], linewidth=0.8, color="gray")
    axes[0].set_title("Сырой сигнал")
    axes[0].set_ylabel("Amplitude (µV)")
    axes[0].grid(True)

    # 4.2 Отфильтрованный сигнал: колеблется вокруг нуля, наводки убраны
    axes[1].plot(t, filt_uv[start:stop], linewidth=0.8)
    axes[1].set_title(f"После фильтра {L_FREQ:g}-{H_FREQ:g} Гц + notch {NOTCH_FREQ:g} Гц")
    axes[1].set_ylabel("Amplitude (µV)")
    axes[1].set_xlabel("Time (seconds)")
    axes[1].grid(True)

    # 4.3 Спектр мощности (метод Уэлча) по всей записи, до и после фильтра.
    # Здесь видно, что фильтр подавил всё ниже 1 Гц и выше 40 Гц, включая пик на 60 Гц.
    nperseg = int(4 * sfreq)  # окна по 4 секунды: разрешение по частоте 0.25 Гц
    f_raw, p_raw = welch(raw_uv, fs=sfreq, nperseg=nperseg)
    f_flt, p_flt = welch(filt_uv, fs=sfreq, nperseg=nperseg)
    axes[2].semilogy(f_raw, p_raw, color="gray", linewidth=1, label="Сырой")
    axes[2].semilogy(f_flt, p_flt, linewidth=1, label="Отфильтрованный")
    axes[2].axvspan(L_FREQ, H_FREQ, color="green", alpha=0.08, label="Полоса пропускания")
    axes[2].axvline(NOTCH_FREQ, color="red", linestyle="--", linewidth=1,
                    label=f"Сеть {NOTCH_FREQ:g} Гц")
    axes[2].set_title("Спектр мощности")
    axes[2].set_xlabel("Frequency (Hz)")
    axes[2].set_ylabel("PSD (µV²/Hz)")
    axes[2].set_xlim(0, sfreq / 2)
    axes[2].grid(True, which="both", alpha=0.3)
    axes[2].legend(loc="upper right")

    plt.show()


if __name__ == "__main__":
    main()
